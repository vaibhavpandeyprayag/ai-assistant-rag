# AI Assistant with RAG - example environment configuration.
# Copy to `.env` and adjust values. Never commit the real `.env`.

# --- Application ---
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM ---
LLM_PROVIDER=hf
HUGGINGFACE_MODEL=microsoft/Phi-3-mini-4k-instruct
# Create a free access token at https://huggingface.co/settings/tokens (read
# scope is sufficient for the Inference API), then copy the real value into
# your local `.env` file. Never put a real token in this example file.
HUGGINGFACE_API_KEY=

# --- Embeddings ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage ---
CHROMA_PERSIST_DIRECTORY=data/chroma
UPLOAD_DIRECTORY=data/uploads

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_STRATEGY=recursive

# --- Retrieval ---
TOP_K=5
RETRIEVAL_MIN_SCORE=0.0

# --- Upload limits ---
UPLOAD_MAX_SIZE_MB=20
